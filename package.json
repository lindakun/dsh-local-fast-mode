{
  "name": "dsh-local-fast-mode",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "DSH 快速模式：先返回已确认结论，未授权时按预算有限取证；另提供显式完整执行预设，不绑定设备、协议或具体业务",
  "exports": {
    "./tuning": "./fast-tuning.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "test": "node --test authorization.test.mjs fast-tuning.test.mjs",
    "test:integration": "node verify-budget.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lindakun/dsh-local-fast-mode.git"
  },
  "homepage": "https://github.com/lindakun/dsh-local-fast-mode#readme",
  "bugs": {
    "url": "https://github.com/lindakun/dsh-local-fast-mode/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-v4.1-flash-1017",
    "fast-mode"
  ]
}
